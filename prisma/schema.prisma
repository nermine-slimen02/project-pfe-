generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ticket {
  id            String   @id @default(uuid())
  title         String
  description   String
  status        String   @default("OPEN")
  priority      String   @default("MEDIUM")

  slaDeadline   DateTime?
  isLate        Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  assignedToId  String?

  user          User     @relation("CreatedTickets", fields: [userId], references: [id])
  assignedTo    User?    @relation("AssignedTickets", fields: [assignedToId], references: [id])
  interventions Intervention[] @relation("TicketInterventions")
  comments      Comment[] @relation("TicketComments")
  notifications Notification[] @relation("TicketNotifications")
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String
  role            String   @default("USER")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdTickets  Ticket[] @relation("CreatedTickets")
  assignedTickets Ticket[] @relation("AssignedTickets")
  interventions   Intervention[] @relation("TechnicianInterventions")
  comments        Comment[] @relation("UserComments")
  notifications   Notification[] @relation("UserNotifications")
}

model Comment {
  id          String   @id @default(uuid())
  content     String
  type        String   @default("PUBLIC")
  ticketId    String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ticket      Ticket   @relation("TicketComments", fields: [ticketId], references: [id])
  user        User     @relation("UserComments", fields: [userId], references: [id])
}

model Intervention {
  id                String   @id @default(uuid())

  ticketId          String
  technicianId      String

  dateDebut         DateTime?
  dateFin           DateTime?

  rapport           String?
  statut            String   @default("EN_ATTENTE")
  tempsPasse        Int?
  actionsRealisees  String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ticket            Ticket   @relation("TicketInterventions", fields: [ticketId], references: [id])
  technician        User     @relation("TechnicianInterventions", fields: [technicianId], references: [id])
}
model Notification {
  id        String   @id @default(uuid())
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)

  userId    String
  ticketId  String?

  createdAt DateTime @default(now())

  user      User     @relation("UserNotifications", fields: [userId], references: [id])
  ticket    Ticket?  @relation("TicketNotifications", fields: [ticketId], references: [id])
}